# Skopiuj do .env i uzupełnij. Nie commituj .env.
POSTGRES_USER=analizator
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=analizator
DATABASE_URL=postgresql+psycopg://analizator:zmien-mnie@db:5432/analizator

ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=0.50
AGENT_MAX_FINDINGS=60
AGENT_TIMEOUT_S=300
MAX_CONTRACT_CHARS=200000
SESSION_TTL_HOURS=12

# Lokalnie (HTTP) false; produkcja (HTTPS) ustawia true.
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Hasła kont demo tworzonych przez seed (puste = konto nie jest tworzone).
SEED_ASSISTANT_PASSWORD=
SEED_LAWYER_PASSWORD=
