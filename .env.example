# Skopiuj do .env i uzupełnij. Nie commituj .env.
POSTGRES_USER=analizator
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=analizator
# Hasło w DATABASE_URL musi być takie samo jak POSTGRES_PASSWORD — zmieniaj je razem.
DATABASE_URL=postgresql+psycopg://analizator:zmien-mnie@db:5432/analizator

ANTHROPIC_API_KEY=
# Dostawca modelu: anthropic (Claude API, klucz powyżej) | foundry (Microsoft Foundry, poniżej).
LLM_PROVIDER=anthropic
# Tylko dla LLM_PROVIDER=foundry: klucz z „Endpoints and keys” i sama nazwa zasobu (nie URL).
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
AGENT_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-haiku-5-5
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=0.50
AGENT_MAX_FINDINGS=60
AGENT_TIMEOUT_S=300
# Ponowienia przy przeciążeniu lub błędzie API (429/5xx), z rosnącym odstępem.
# Klasyfikator po wyczerpaniu ponowień kieruje analizę do kwarantanny.
CLASSIFIER_MAX_RETRIES=5
AGENT_MAX_RETRIES=10
MAX_CONTRACT_CHARS=200000
SESSION_TTL_HOURS=12

# Lokalnie (HTTP) false; produkcja (HTTPS) ustawia true.
COOKIE_SECURE=false
LOG_LEVEL=INFO

# Nazwa kancelarii w nagłówku raportu PDF.
REPORT_FIRM_NAME=Kancelaria Przykładowa (dane fikcyjne)

# Hasła kont demo tworzonych przez seed (puste = konto nie jest tworzone).
SEED_ASSISTANT_PASSWORD=
SEED_LAWYER_PASSWORD=
